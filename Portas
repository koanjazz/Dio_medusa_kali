#!/bin/bash

# Visual header for the terminal output
echo "_____________________"
echo "Checking Open Ports"
echo "_____________________"

# COMPATIBILITY CHECK:
# Check if 'ss' (Socket Statistics) command exists.
# '>/dev/null 2>&1' redirects output and errors to null to keep the terminal clean.
if command -v ss >/dev/null 2>&1; then
  echo "[+] Using 'ss' to verify ports..."
  # -t: TCP, -u: UDP, -l: Listening, -n: Numeric, -p: Show Process/PID
  ss -tulnp

# Fallback: check if 'netstat' exists if 'ss' is not found
elif command -v netstat >/dev/null 2>&1; then
  echo "[+] Using 'netstat' to verify ports..."
  # Same flags as 'ss' for consistent results
  netstat -tulnp

# Error handling if neither tool is installed
else
    echo "[-] Error: No network tool found (ss or netstat)."
    exit 1
fi

# Visual footer
echo "--------------------------------"
echo "Analysis Completed"
echo "-------------------------------"
